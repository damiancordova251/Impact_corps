# Local Express server port. Hosted platforms usually provide PORT automatically.
PORT=3000
# Use 127.0.0.1 for local development. Hosted services should omit HOST or set 0.0.0.0.
HOST=127.0.0.1

# Web Push VAPID keys identify this backend to browser push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler interval controls how often the backend checks reminder timing.
# Set ENABLE_EXPRESS_SCHEDULER=false on Render when Cloudflare Worker Cron is active.
ENABLE_EXPRESS_SCHEDULER=true
SCHEDULER_INTERVAL_MS=30000

# Supabase Free/Postgres settings for persistent subscriptions and pilot events.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUSH_SUBSCRIPTIONS_TABLE=push_subscriptions
SUPABASE_PILOT_EVENTS_TABLE=pilot_events
